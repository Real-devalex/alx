{
    "name": "alx-language-support",
    "displayName": "ALX Language Support",
    "description": "The home of ALX, a beginner-first language for making games. Colours, snippets, smart completions, hover help, a run button and the ALX Night theme.",
    "version": "0.7.0",
    "publisher": "AlexionStudios",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Themes"
    ],
    "activationEvents": [],
    "main": "./extension.js",
    "contributes": {
        "languages": [
            {
                "id": "alx",
                "aliases": [
                    "ALX",
                    "alx"
                ],
                "extensions": [
                    ".alx"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "dark": "./icons/file-icon-dark.svg",
                    "light": "./icons/file-icon-light.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "alx",
                "scopeName": "source.alx",
                "path": "./syntaxes/ALX.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "alx.runFile",
                "title": "ALX: Run File",
                "icon": "$(play)"
            },
            {
                "command": "alx.showVersion",
                "title": "ALX: Show Installed Version"
            },
            {
                "command": "alx.openDocs",
                "title": "ALX: Open Documentation"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "alx.runFile",
                    "when": "editorLangId == alx",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                {
                    "command": "alx.runFile",
                    "when": "editorLangId == alx"
                },
                {
                    "command": "alx.showVersion"
                },
                {
                    "command": "alx.openDocs"
                }
            ]
        },
        "keybindings": [
            {
                "command": "alx.runFile",
                "key": "ctrl+alt+r",
                "mac": "cmd+alt+r",
                "when": "editorLangId == alx"
            }
        ],
        "configuration": {
            "title": "ALX",
            "properties": {
                "alx.executablePath": {
                    "type": "string",
                    "default": "alx",
                    "description": "Path to the ALX executable. Leave as 'alx' if it's in your PATH."
                },
                "alx.showStatusBar": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show a Run button in the status bar while an ALX file is open."
                }
            }
        },
        "snippets": [
            {
                "language": "alx",
                "path": "./snippets/alx.json"
            }
        ],
        "themes": [
            {
                "label": "ALX Night",
                "uiTheme": "vs-dark",
                "path": "./themes/alx-night-color-theme.json"
            }
        ]
    },
    "scripts": {
        "package": "vsce package",
        "test": "node test/logic.test.js"
    },
    "keywords": [
        "alx",
        "alexion",
        "game",
        "game development",
        "language",
        "beginner"
    ],
    "author": "Alexion Studios",
    "license": "SEE LICENSE IN LICENSE.txt",
    "type": "commonjs",
    "devDependencies": {
        "@vscode/vsce": "^3.9.2"
    },
    "icon": "icon.png",
    "homepage": "https://real-devalex.github.io/alx/",
    "repository": {
        "type": "git",
        "url": "https://github.com/Real-devalex/alx.git",
        "directory": "vscode-extension"
    },
    "bugs": {
        "url": "https://github.com/Real-devalex/alx/issues"
    },
    "galleryBanner": {
        "color": "#140b2e",
        "theme": "dark"
    }
}