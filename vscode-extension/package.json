{
    "name": "alx-language-support",
    "displayName": "ALX Language Support",
    "description": "Syntax highlighting, run support, and language tools for ALX programming language",
    "version": "0.4.0",
    "publisher": "AlexionStudios",
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [],
    "main": "./extension.js",

    "contributes": {
        "languages": [
            {
                "id": "alx",
                "aliases": [
                    "ALX",
                    "alx"
                ],
                "extensions": [
                    ".alx"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "dark": "./icons/file-icon-dark.svg",
                    "light": "./icons/file-icon-light.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "alx",
                "scopeName": "source.alx",
                "path": "./syntaxes/ALX.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "alx.runFile",
                "title": "ALX: Run File",
                "icon": "$(play)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "alx.runFile",
                    "when": "editorLangId == alx",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                {
                    "command": "alx.runFile",
                    "when": "editorLangId == alx"
                }
            ]
        },
        "keybindings": [
            {
                "command": "alx.runFile",
                "key": "ctrl+alt+r",
                "mac": "cmd+alt+r",
                "when": "editorLangId == alx"
            }
        ],
        "configuration": {
            "title": "ALX",
            "properties": {
                "alx.executablePath": {
                    "type": "string",
                    "default": "alx",
                    "description": "Path to the ALX executable. Leave as 'alx' if it's in your PATH."
                }
            }
        }
    },
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@vscode/vsce": "^3.9.2"
    }
}
