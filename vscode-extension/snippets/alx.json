{
  "Hello world": {
    "prefix": "hello",
    "body": [
      "print(\"${1:Hello, ALEXION!}\")"
    ],
    "description": "Print a message"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "function ${1:name}(${2:args}) {",
      "\t$0",
      "}"
    ],
    "description": "A function"
  },
  "Short function": {
    "prefix": "afun",
    "body": [
      "afun ${1:name}(${2:args}) {",
      "\t$0",
      "}"
    ],
    "description": "A function written with afun"
  },
  "Lambda": {
    "prefix": "lambda",
    "body": [
      "${1:double} = lambda(${2:x}) { ${3:x * 2} }"
    ],
    "description": "A small unnamed function"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "\tfunction constructor(${2:args}) {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "A class with a constructor"
  },
  "Class with inheritance": {
    "prefix": "classx",
    "body": [
      "class ${1:Child} extends ${2:Parent} {",
      "\tfunction constructor(${3:args}) {",
      "\t\tsuper(${4:args})",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "A class that extends another"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "If"
  },
  "If else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "If and else"
  },
  "Else if chain": {
    "prefix": "ifchain",
    "body": [
      "if ${1:condition} {",
      "\t$2",
      "} else if ${3:other} {",
      "\t$4",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "If, else if, else"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:1}..${3:10} {",
      "\t$0",
      "}"
    ],
    "description": "Loop over a range"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "While loop"
  },
  "Array": {
    "prefix": "arr",
    "body": [
      "${1:items} = [${2:1, 2, 3}]"
    ],
    "description": "An array"
  },
  "Map": {
    "prefix": "map",
    "body": [
      "${1:player} = {",
      "\t${2:name}: ${3:\"Hero\"},",
      "\t${4:health}: ${5:100}",
      "}"
    ],
    "description": "A map"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "import ${1:module}"
    ],
    "description": "Import a module"
  },
  "Constant": {
    "prefix": "const",
    "body": [
      "const ${1:NAME} = ${2:value}"
    ],
    "description": "A constant"
  },
  "Vec2": {
    "prefix": "vec",
    "body": [
      "${1:position} = new Vec2(${2:0}, ${3:0})"
    ],
    "description": "A 2D vector"
  },
  "Entity": {
    "prefix": "entity",
    "body": [
      "${1:hero} = new Entity(\"${2:Hero}\", ${3:0}, ${4:0})",
      "${1:hero}.velocity = new Vec2(${5:1}, ${6:0})"
    ],
    "description": "A game entity that moves"
  },
  "Game loop (text)": {
    "prefix": "gameloop",
    "body": [
      "${1:hero} = new Entity(\"${2:Hero}\", 0, 0)",
      "${1:hero}.velocity = new Vec2(${3:4}, ${4:3})",
      "",
      "for tick in 1..${5:5} {",
      "\t${1:hero}.update(1)",
      "\tprint(\"tick {tick}: {${1:hero}.position.toString()}\")",
      "}"
    ],
    "description": "A small game loop"
  },
  "Dice roll": {
    "prefix": "dice",
    "body": [
      "roll = randomInt(1, 6)",
      "print(\"You rolled {roll}\")"
    ],
    "description": "Roll a six sided die"
  }
}