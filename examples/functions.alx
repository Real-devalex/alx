// Functions in ALX - Demonstrating both 'function' and 'afun' keywords

afun greet(name) {
    print("Hello " + name + "!")
}

greet("Daniel")
greet("ALEXION STUDIOS")

// Return values
afun add(a, b) {
    return a + b
}

result = add(10, 20)
print(result)

// More complex function
afun calculate_damage(base_damage, multiplier) {
    return base_damage * multiplier
}

player_damage = calculate_damage(50, 2.5)
print(player_damage)

// Boolean function
afun is_alive(health) {
    if health > 0 {
        return true
    }
    return false
}

print(is_alive(100))
print(is_alive(0))

// Recursion
afun factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

print(factorial(5))

// Example showing traditional function keyword still works (backward compatibility)
function legacy_add(x, y) {
    return x + y
}

print("Legacy function result: " + legacy_add(3, 4))
