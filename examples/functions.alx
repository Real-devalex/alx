// Functions in ALX

function greet(name) {
    print("Hello " + name + "!")
}

greet("Daniel")
greet("ALEXION STUDIOS")

// Return values
function add(a, b) {
    return a + b
}

result = add(10, 20)
print(result)

// More complex function
function calculate_damage(base_damage, multiplier) {
    return base_damage * multiplier
}

player_damage = calculate_damage(50, 2.5)
print(player_damage)

// Boolean function
function is_alive(health) {
    if health > 0 {
        return true
    }
    return false
}

print(is_alive(100))
print(is_alive(0))

// Recursion
function factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

print(factorial(5))
