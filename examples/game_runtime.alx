// ALX 0.7.0: the game runtime. Math, random numbers, vectors and entities.

// ----- math -----
print("sqrt(144) = " + sqrt(144))
print("clamp(150, 0, 100) = " + clamp(150, 0, 100))
print("lerp(0, 100, 0.25) = " + lerp(0, 100, 0.25))
print("distance from (0,0) to (3,4) = " + new Vec2(0, 0).distanceTo(new Vec2(3, 4)))

// ----- vectors -----
position = new Vec2(10, 20)
velocity = new Vec2(2, -1)
position = position.add(velocity.scale(5))
print("after 5 steps: " + position.toString())

// ----- a tiny game loop -----
hero = new Entity("Hero", 0, 0)
hero.velocity = new Vec2(4, 3)
enemy = new Entity("Slime", 20, 15)

step = 0
while step < 4 {
    hero.update(1)
    step = step + 1
    print("tick {step}: {hero.name} at {hero.position.toString()}, {round(hero.distanceTo(enemy))} away from {enemy.name}")
}

// ----- random loot -----
roll = randomInt(1, 6)
print("You rolled a {roll}")
if roll >= 5 {
    print("Rare drop!")
} else {
    print("Common drop")
}
